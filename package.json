{
  "name": "pdf-render-service",
  "version": "0.1.0",
  "description": "HTTP service that renders PDFs from a JSON layout and data payload, built on react-pdf.",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkywardApps/pdf-render-service.git"
  },
  "author": "Nicholas Elliott",
  "license": "MIT",
  "private": true,
  "scripts": {
    "tsc": "tsc",
    "start": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "build": "tsc",
    "debug": "cross-env TZ=UTC NODE_ENV=development tsnd --inspect --respawn src/index.ts",
    "release": "tsc && node ./dist/index.js",
    "update-types": "npx ts-json-schema-generator -f tsconfig.json -i PdfRequest --path ./src/wire/PdfRequest.ts --type PdfRequest -o ./src/resources/PdfRequest.json",
    "profile": "tsc && node --prof ./dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.5",
    "ajv": "^8.18.0",
    "axios": "^1.20.0",
    "react": "^16.12.0",
    "vm2": "^3.12.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^16.9.12",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "nock": "^14.0.14",
    "pdfjs-dist": "^6.2.108",
    "ts-json-schema-generator": "^2.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "engines": {
    "node": ">=24"
  }
}
