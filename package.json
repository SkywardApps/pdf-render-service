{
  "name": "pdfengine",
  "version": "0.1.0",
  "main": "index.js",
  "author": "Nicholas Elliott",
  "license": "MIT",
  "private": true,
  "scripts": {
    "tsc": "tsc",
    "start": "ts-node-dev --respawn --transpile-only ./src/index.ts",
    "build": "tsc",
    "debug": "cross-env TZ=UTC NODE_ENV=development tsnd --inspect --respawn src/index.ts",
    "release": "tsc && node ./dist/index.js",
    "update-types": "npx ts-json-schema-generator -f tsconfig.json -i PdfRequest --path ./src/wire/PdfRequest.ts --type PdfRequest -o ./src/resources/PdfRequest.json",
    "profile": "tsc && node --prof ./dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'test/**/*.{ts,tsx}' --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.4.5",
    "ajv": "^8.17.1",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "fontkit": "2",
    "fonts": "^0.0.2",
    "react": "^16.12.0",
    "uuid": "^9.0.0",
    "vm2": "^3.10.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.8",
    "@types/node": "^20.19.25",
    "@types/react": "^16.9.12",
    "@types/request": "^2.48.13",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.1.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "nock": "^14.0.14",
    "pdfjs-dist": "^5.7.284",
    "ts-json-schema-generator": "^2.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  },
  "volta": {
    "node": "20.18.1",
    "yarn": "3.6.1"
  },
  "packageManager": "yarn@3.6.1"
}
